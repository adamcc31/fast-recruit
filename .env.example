# CV Screening Pipeline — copy to .env and fill in
# cp .env.example .env

# ─── LLM connection (OpenAI-compatible chat-completions endpoint) ───

# Opsi A: Meta Muse Spark
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3-contributor
LLM_API_KEY=isi-api-key-anda-disini

# Opsi B: OpenAI / Codex (ganti 3 baris di atas dengan ini)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5-codex
# LLM_API_KEY=sk-...

# Opsi C: Ollama lokal (tanpa API key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama

# ─── Kriteria knockout (hard filter — gagal = REJECT) ───
# Domisili yang diterima (koma). Kosongkan = tanpa filter lokasi.
JOB_LOCATION=Bekasi, Jakarta
# Minimal pengalaman tahun. 0 = tanpa filter.
MIN_YEARS_EXPERIENCE=2
# Deskripsi lowongan panjang? Taruh di file teks, contoh:
# JOB_DESCRIPTION_FILE=lowongan.txt

# ─── LLM tuning ───
# Reasoning effort: low | medium | high (kosongkan = mati)
LLM_REASONING_EFFORT=medium
# Token budget per panggilan (reasoning makan jatah ini juga — jangan < 3000
# untuk model reasoning seperti Muse Spark)
# LLM_MAX_TOKENS=4000
# Estimasi biaya USD per 1 juta token (0 = tampilkan token saja)
# LLM_COST_INPUT_PER_1M=0
# LLM_COST_OUTPUT_PER_1M=0

# ─── PDF ───
# 0 = semua halaman (disarankan). 1 = halaman pertama saja.
# PDF_MAX_PAGES=0

# ─── Opsional ───
# INPUT_DIR=cv
# JOB_TITLE=HR Manager
# SHORTLIST_MIN_SCORE=7.0
# REVIEW_MIN_SCORE=5.0
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=4
# LLM_TEMPERATURE=0.2
# API_DELAY_SECONDS=0.5
